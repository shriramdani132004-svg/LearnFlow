// LearnFlow database schema
// PostgreSQL + Prisma ORM 7

generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  TIMED_OUT
  GRADED
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(STUDENT)
  avatarUrl    String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  sessions       Session[]
  coursesTaught  Course[]         @relation("InstructorCourses")
  enrollments    Enrollment[]
  questions      Question[]
  assessments    Assessment[]
  attempts       AssessmentAttempt[]
  results        AssessmentResult[]
  activityEvents ActivityEvent[]

  @@index([role])
  @@index([createdAt])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Course {
  id           String       @id @default(cuid())
  instructorId String
  title        String
  slug         String       @unique
  description  String
  category     String
  level        String
  thumbnailUrl String?
  status       CourseStatus @default(DRAFT)
  publishedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  instructor   User              @relation("InstructorCourses", fields: [instructorId], references: [id], onDelete: Restrict)
  modules      CourseModule[]
  enrollments  Enrollment[]
  questions    Question[]
  assessments  Assessment[]
  activityEvents ActivityEvent[]

  @@index([status, publishedAt])
  @@index([instructorId, status])
  @@index([category, level])
  @@index([title])
}

model CourseModule {
  id          String @id @default(cuid())
  courseId    String
  title       String
  description String?
  position    Int

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([courseId, position])
  @@index([courseId])
}

model Lesson {
  id               String  @id @default(cuid())
  moduleId         String
  title            String
  content          String
  resourceUrl      String?
  position         Int
  estimatedMinutes Int     @default(10)
  published        Boolean @default(false)

  module   CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@unique([moduleId, position])
  @@index([moduleId])
}

model Enrollment {
  id          String           @id @default(cuid())
  courseId    String
  studentId   String
  status      EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?
  updatedAt   DateTime         @updatedAt

  course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student        User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonProgress LessonProgress[]

  @@unique([courseId, studentId])
  @@index([studentId, status])
  @@index([courseId, status])
}

model LessonProgress {
  id           String   @id @default(cuid())
  enrollmentId String
  lessonId     String
  completedAt  DateTime @default(now())

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([lessonId])
}

model Question {
  id           String     @id @default(cuid())
  instructorId String
  courseId     String
  questionText String
  explanation  String?
  difficulty   Difficulty @default(MEDIUM)
  topic        String
  marks        Int        @default(1)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  instructor  User                 @relation(fields: [instructorId], references: [id], onDelete: Restrict)
  course      Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  options     QuestionOption[]
  assessmentQuestions AssessmentQuestion[]
  attemptQuestions    AttemptQuestion[]

  @@index([courseId, difficulty])
  @@index([instructorId])
  @@index([topic])
  @@index([questionText])
}

model QuestionOption {
  id         String  @id @default(cuid())
  questionId String
  optionText String
  isCorrect  Boolean @default(false)
  position   Int

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, position])
  @@index([questionId])
}

model Assessment {
  id                    String      @id @default(cuid())
  courseId              String
  instructorId          String
  title                 String
  description           String?
  instructions          String?
  durationMinutes       Int
  totalQuestions        Int
  totalMarks            Int
  passPercentage        Int         @default(40)
  maxAttempts           Int         @default(1)
  availableFrom         DateTime?
  availableUntil        DateTime?
  published             Boolean     @default(false)
  publishedAt           DateTime?
  shuffleQuestions      Boolean     @default(true)
  shuffleOptions        Boolean     @default(true)
  showResultsImmediately Boolean    @default(true)
  allowAnswerReview     Boolean    @default(true)
  resultsReleasedAt     DateTime?
  topicFilter           String?
  difficultyFilter      Difficulty?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructor  User     @relation(fields: [instructorId], references: [id], onDelete: Restrict)
  questions   AssessmentQuestion[]
  attempts    AssessmentAttempt[]
  results     AssessmentResult[]

  @@index([courseId, published])
  @@index([instructorId, published])
  @@index([availableFrom, availableUntil])
}

model AssessmentQuestion {
  id           String @id @default(cuid())
  assessmentId String
  questionId   String
  position     Int

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([assessmentId, questionId])
  @@unique([assessmentId, position])
  @@index([questionId])
}

model AssessmentAttempt {
  id           String         @id @default(cuid())
  assessmentId String
  studentId    String
  attemptNumber Int
  startedAt    DateTime       @default(now())
  expiresAt    DateTime
  submittedAt  DateTime?
  finalizedAt  DateTime?
  status       AttemptStatus  @default(IN_PROGRESS)
  score        Int?
  percentage   Float?
  passed       Boolean?
  createdAt    DateTime       @default(now())

  assessment   Assessment        @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student      User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  questions    AttemptQuestion[]
  result       AssessmentResult?

  @@unique([assessmentId, studentId, attemptNumber])
  @@index([studentId, status, createdAt])
  @@index([assessmentId, status])
  @@index([status, expiresAt])
}

model AttemptQuestion {
  id                   String  @id @default(cuid())
  attemptId            String
  originalQuestionId   String
  position             Int
  questionTextSnapshot String
  explanationSnapshot  String?
  topicSnapshot        String
  marksSnapshot        Int
  correctAttemptOptionId String?

  attempt          AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  originalQuestion Question          @relation(fields: [originalQuestionId], references: [id], onDelete: Restrict)
  options          AttemptOption[]
  answer           AttemptAnswer?

  @@unique([attemptId, position])
  @@unique([attemptId, originalQuestionId])
  @@index([originalQuestionId])
}

model AttemptOption {
  id                String @id @default(cuid())
  attemptQuestionId String
  optionTextSnapshot String
  position          Int
  originalOptionId  String?

  attemptQuestion AttemptQuestion @relation(fields: [attemptQuestionId], references: [id], onDelete: Cascade)

  @@unique([attemptQuestionId, position])
  @@index([attemptQuestionId])
}

model AttemptAnswer {
  id                     String   @id @default(cuid())
  attemptQuestionId      String   @unique
  selectedAttemptOptionId String?
  answeredAt             DateTime @default(now())
  updatedAt              DateTime @updatedAt

  attemptQuestion AttemptQuestion @relation(fields: [attemptQuestionId], references: [id], onDelete: Cascade)

  @@index([selectedAttemptOptionId])
}

model AssessmentResult {
  id             String   @id @default(cuid())
  attemptId      String   @unique
  assessmentId   String
  studentId      String
  score          Int
  percentage     Float
  passed         Boolean
  correctCount   Int
  totalQuestions Int
  totalMarks     Int
  submittedAt    DateTime
  createdAt      DateTime @default(now())

  attempt    AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  assessment Assessment        @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student    User              @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([assessmentId, createdAt])
  @@index([studentId, createdAt])
  @@index([studentId, assessmentId])
}

model ActivityEvent {
  id           String   @id @default(cuid())
  userId       String?
  courseId     String?
  assessmentId String?
  type         String
  message      String
  metadata     Json?
  createdAt    DateTime @default(now())

  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  course     Course?    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([courseId, createdAt])
  @@index([type, createdAt])
}
