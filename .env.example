# ---------------------------------------------------------------------------
# LearnFlow environment (copy to .env and fill in real values)
# Never commit the resulting .env file.
# ---------------------------------------------------------------------------

# Runtime and database
NODE_ENV=development
PORT=4000
# Pooled PostgreSQL connection used by the application at runtime.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Direct (non-pooled) PostgreSQL connection used only for Prisma migrations.
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require
# Dedicated database for integration/e2e tests (never the production branch).
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST-test-pooler.REGION.aws.neon.tech/neondb?sslmode=require
TEST_DIRECT_URL=postgresql://USER:PASSWORD@HOST-test.REGION.aws.neon.tech/neondb?sslmode=require

# Authentication secrets (at least 32 characters, must be different)
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Same-origin browser origin allowed by CORS and CSRF checks.
FRONTEND_ORIGIN=http://localhost:3000

# Set to false only for plain-HTTP local development.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Optional: enables POST /api/v1/auth/bootstrap-instructor when the header matches.
INSTRUCTOR_BOOTSTRAP_SECRET=
# Remove the bootstrap secret after creating the first instructor account.

# Optional: used by `pnpm prisma:seed` to create initial operator accounts.
SEED_PASSWORD=
SEED_ADMIN_EMAIL=
SEED_INSTRUCTOR_EMAIL=
SEED_STUDENT_EMAIL=
